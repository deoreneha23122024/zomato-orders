{
  "info": {
    "name": "Zomato Orders API — Video Walkthrough Tests",
    "description": "Clean, simple test collection containing ONLY the exact 6 requests demonstrated in the Loom video presentation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Default Pagination (limit=10, offset=0)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r = pm.response.json();",
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Returns 10 records by default', () => pm.expect(r.length).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Custom Pagination (limit=4, offset=1)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders?limit=4&offset=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"],
          "query": [
            { "key": "limit", "value": "4" },
            { "key": "offset", "value": "1" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r = pm.response.json();",
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Returns exactly 4 records', () => pm.expect(r.length).to.eql(4));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Validation: String Limit (limit=abc)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders?limit=abc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"],
          "query": [
            { "key": "limit", "value": "abc" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r = pm.response.json();",
              "pm.test('Status 200 OK (No crash)', () => pm.response.to.have.status(200));",
              "pm.test('Falls back to default 10 records', () => pm.expect(r.length).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Validation: Negative Limit (limit=-5)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders?limit=-5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"],
          "query": [
            { "key": "limit", "value": "-5" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r = pm.response.json();",
              "pm.test('Status 200 OK (No crash)', () => pm.response.to.have.status(200));",
              "pm.test('Falls back to default 10 records', () => pm.expect(r.length).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Validation: Decimal Limit (limit=2.5)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders?limit=2.5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"],
          "query": [
            { "key": "limit", "value": "2.5" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r = pm.response.json();",
              "pm.test('Status 200 OK (No crash)', () => pm.response.to.have.status(200));",
              "pm.test('Falls back to default 10 records', () => pm.expect(r.length).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Health Check (GET /)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const r = pm.response.json();",
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('API is running successfully', () => pm.expect(r.message).to.include('running'));"
            ]
          }
        }
      ]
    }
  ]
}
